# Base URL của API. Mặc định dùng proxy của Vite (/api -> backend), nên khi dev không cần đổi.
VITE_API_URL=/api/v1

# Địa chỉ backend mà Vite proxy chuyển tới khi chạy `npm run dev`
VITE_PROXY_TARGET=http://localhost:3000

# Prerender trang công khai lúc build (F-PUB-04). Để trống = bỏ qua, trang công khai chạy CSR
# Ví dụ: http://localhost:3000/api/v1 hoặc https://hireflow-api.onrender.com/api/v1
PRERENDER_API_URL=
# Domain thật để ghi canonical / og:url (trên Vercel tự lấy VERCEL_PROJECT_PRODUCTION_URL)
PRERENDER_SITE_URL=
# true = build lỗi khi không prerender được
PRERENDER_STRICT=false

# ===== App =====
NODE_ENV=development
PORT=3000
API_PREFIX=api
# Danh sách origin cho CORS, ngăn cách bởi dấu phẩy (để trống = cho phép tất cả)
CORS_ORIGINS=http://localhost:5173

# ===== Database (PostgreSQL) =====
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=ncc_intern
# Chỉ bật synchronize khi thử nghiệm nhanh – thực tế dùng migration
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ===== JWT (secret tối thiểu 32 ký tự) =====
# Tạo secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
# Thời hạn tính bằng giây (900 = 15 phút, 604800 = 7 ngày)
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_REFRESH_EXPIRES_IN=604800

# ===== Rate limit =====
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ===== Seed =====
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@123

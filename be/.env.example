# ===== App =====
NODE_ENV=development
PORT=3000
API_PREFIX=api
# Danh sách origin cho CORS, ngăn cách bởi dấu phẩy (để trống = cho phép tất cả)
CORS_ORIGINS=http://localhost:5173

# ===== Database (PostgreSQL) =====
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=ncc_intern
# Chỉ bật synchronize khi thử nghiệm nhanh – thực tế dùng migration
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ===== JWT (secret tối thiểu 32 ký tự) =====
# Tạo secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
# Thời hạn tính bằng giây (900 = 15 phút, 604800 = 7 ngày)
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# ===== Rate limit =====
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ===== Seed =====
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@123

# ===== AI (miễn phí: Gemini free tier → Groq free tier → Ollama local) =====
# Thứ tự dự phòng, cách nhau bằng dấu phẩy: gemini, groq, ollama, fake (test/CI dùng fake)
LLM_PROVIDERS=fake
AI_TIMEOUT_MS=60000
AI_PROMPT_VERSION=v1
# Key tạo ở https://aistudio.google.com (không cần thẻ); tên model xem trong AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_MODEL_EXTRACT=
# Key tạo ở https://console.groq.com; tên model xem trong console
GROQ_API_KEY=
GROQ_MODEL=
GROQ_JSON_MODE=json_object
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_JSON_MODE=json_schema
# Embedding: ollama (bge-m3, 1024 chiều) hoặc fake
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

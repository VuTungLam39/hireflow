# ===== App =====
NODE_ENV=development
PORT=3000
API_PREFIX=api
# Danh sách origin cho CORS, ngăn cách bởi dấu phẩy (để trống = cho phép tất cả)
CORS_ORIGINS=http://localhost:5173

# ===== Database (PostgreSQL) =====
# Postgres có pgvector trong docker compose chạy ở cổng POSTGRES_HOST_PORT (mặc định 5433)
POSTGRES_HOST_PORT=5433
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=ncc_intern
# Chỉ bật synchronize khi thử nghiệm nhanh – thực tế dùng migration
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ===== JWT (secret tối thiểu 32 ký tự) =====
# Tạo secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
# Thời hạn tính bằng giây (900 = 15 phút, 604800 = 7 ngày)
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# ===== Redis (BullMQ) – docker compose up -d redis =====
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== Lưu file CV =====
# local: thư mục STORAGE_LOCAL_ROOT; s3: object storage S3-compatible (RustFS trong docker compose)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=storage
S3_ENDPOINT=http://localhost:9000
# Địa chỉ trình duyệt truy cập được, dùng để ký presigned URL (để trống = S3_ENDPOINT)
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=hireflow-cv
S3_ACCESS_KEY=hireflow
S3_SECRET_KEY=hireflow-secret
S3_FORCE_PATH_STYLE=true

# ===== Rate limit =====
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ===== Seed =====
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@123

# ===== AI (miễn phí: Gemini free tier → Groq free tier → Ollama local) =====
# Thứ tự dự phòng, cách nhau bằng dấu phẩy: gemini, groq, ollama, fake (test/CI dùng fake)
LLM_PROVIDERS=fake
AI_TIMEOUT_MS=60000
AI_PROMPT_VERSION=v1
# Key tạo ở https://aistudio.google.com (không cần thẻ); tên model xem trong AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_MODEL_EXTRACT=
# Key tạo ở https://console.groq.com; tên model xem trong console
GROQ_API_KEY=
GROQ_MODEL=
GROQ_JSON_MODE=json_object
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_JSON_MODE=json_schema
# Embedding: gemini (mặc định gemini-embedding-2), ollama (mặc định bge-m3) hoặc fake; luôn 1024 chiều
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=100
